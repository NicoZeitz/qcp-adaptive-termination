from collections.abc import Iterator
from enum import Enum

class tgt_hll_type(Enum):
    HLL_4: tgt_hll_type
    HLL_6: tgt_hll_type
    HLL_8: tgt_hll_type

class theta_sketch:
    def __iter__(self) -> Iterator[int]: ...
    def __str__(self) -> str: ...
    def get_estimate(self) -> float: ...
    def get_lower_bound(self, num_std_devs: int) -> float: ...
    def get_upper_bound(self, num_std_devs: int) -> float: ...
    def get_seed_hash(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_estimation_mode(self) -> bool: ...
    def is_ordered(self) -> bool: ...
    def to_string(self, print_items: bool = False) -> str: ...
    @property
    def num_retained(self) -> int: ...
    @property
    def theta(self) -> float: ...
    @property
    def theta64(self) -> int: ...

class update_theta_sketch(theta_sketch):
    def __init__(self, lg_k: int = 12, p: float = 1.0, seed: int = 9001) -> None: ...
    def __copy__(self) -> update_theta_sketch: ...
    def update(self, datum: int | float | str) -> None: ...
    def compact(self, ordered: bool = True) -> compact_theta_sketch: ...
    def reset(self) -> None: ...
    def trim(self) -> None: ...

class compact_theta_sketch(theta_sketch):
    def __init__(self, other: theta_sketch, ordered: bool) -> None: ...
    def __copy__(self) -> compact_theta_sketch: ...
    def serialize(self, compress: bool = False) -> bytes: ...
    @staticmethod
    def deserialize(data: bytes, seed: int = 9001) -> compact_theta_sketch: ...

class theta_union:
    def __init__(self, lg_k: int = 12, p: float = 1.0, seed: int = 9001) -> None: ...
    def update(self, sketch: theta_sketch) -> None: ...
    def get_result(self, ordered: bool = True) -> compact_theta_sketch: ...

class theta_intersection:
    def __init__(self, seed: int = 9001) -> None: ...
    def update(self, sketch: theta_sketch) -> None: ...
    def get_result(self, ordered: bool = True) -> compact_theta_sketch: ...
    def has_result(self) -> bool: ...

class theta_a_not_b:
    def __init__(self, seed: int = 9001) -> None: ...
    def compute(self, a: theta_sketch, b: theta_sketch, ordered: bool = True) -> compact_theta_sketch: ...

class hll_sketch:
    def __init__(self, lg_k: int, tgt_type: tgt_hll_type = tgt_hll_type.HLL_8, start_max_size: bool = False) -> None: ...
    def __str__(self) -> str: ...
    def update(self, datum: int | float | str) -> None: ...
    def get_estimate(self) -> float: ...
    def get_lower_bound(self, num_std_devs: int) -> float: ...
    def get_upper_bound(self, num_std_devs: int) -> float: ...
    def is_empty(self) -> bool: ...
    def is_compact(self) -> bool: ...
    def reset(self) -> None: ...
    def serialize_compact(self) -> bytes: ...
    def serialize_updatable(self) -> bytes: ...
    def get_compact_serialization_bytes(self) -> int: ...
    def get_updatable_serialization_bytes(self) -> int: ...
    def to_string(self, summary: bool = True, detail: bool = False, aux_detail: bool = False, all: bool = False) -> str: ...
    @property
    def lg_config_k(self) -> int: ...
    @property
    def tgt_type(self) -> tgt_hll_type: ...
    @staticmethod
    def deserialize(data: bytes) -> hll_sketch: ...
    @staticmethod
    def get_max_updatable_serialization_bytes(lg_k: int, tgt_type: tgt_hll_type) -> int: ...
    @staticmethod
    def get_rel_err(upper_bound: bool, unioned: bool, lg_k: int, num_std_devs: int) -> float: ...

class hll_union:
    def __init__(self, lg_max_k: int) -> None: ...
    def update(self, sketch_or_datum: hll_sketch | int | float | str) -> None: ...
    def get_result(self, tgt_type: tgt_hll_type = tgt_hll_type.HLL_4) -> hll_sketch: ...
    def get_estimate(self) -> float: ...
    def get_lower_bound(self, num_std_devs: int) -> float: ...
    def get_upper_bound(self, num_std_devs: int) -> float: ...
    def is_empty(self) -> bool: ...
    def reset(self) -> None: ...

HLL_4: tgt_hll_type
HLL_6: tgt_hll_type
HLL_8: tgt_hll_type
