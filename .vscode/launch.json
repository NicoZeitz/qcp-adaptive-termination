{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: main.py",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: stages.py - Stage 1",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/stages.py",
            "args": ["--stage", "1"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: stages.py - Stage 2",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/stages.py",
            "args": ["--stage", "2"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: stages.py - Stage 3",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/stages.py",
            "args": ["--stage", "3"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: stages.py - Stage 0",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/stages.py",
            "args": ["--stage", "0"],
            "console": "integratedTerminal"
        }
    ]
}