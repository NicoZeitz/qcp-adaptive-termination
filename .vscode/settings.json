{
    "python.defaultInterpreterPath": "/Users/I550817/SAPDevelop/Lectures/qcp-prototype/.venv/bin/python",
    "python.terminal.useEnvFile": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.ruff_cache": true,
        // "**/.cache": true,
        "**/.logs": true,
    },
    "explorer.fileNesting.patterns": {
        "README.md": "TODO.md",
        "pyproject.toml": "uv.lock, .python-version",
        "*.json": "${capture}.pkl",
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "Cargo.toml": "Cargo.lock"
    },
    "cSpell.words": [
        "akas",
        "alru",
        "asyncio",
        "bindparam",
        "bindparams",
        "Bonferroni's",
        "chao",
        "datasketches",
        "dayfirst",
        "DBSCAN",
        "dotenv",
        "faiss",
        "getlogin",
        "imdb",
        "Instrumentor",
        "jaccard",
        "linalg",
        "linprog",
        "millis",
        "minhash",
        "mschema",
        "numpy",
        "openinference",
        "pytest",
        "qtypes",
        "Segoe",
        "siliconvalley",
        "sqlalchemy",
        "testpaths",
        "vldbsigmod",
        "yearfirst"
    ],
    "python.testing.pytestArgs": [
        "test"
    ],
    "pylint.enabled": false,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "[rq]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    }
}