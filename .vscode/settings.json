{
    "search.useIgnoreFiles": false,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.ruff_cache": true,
        // "**/.cache": true,
        // "**/.logs": true,
        "**/.claude": true,
    },
    "explorer.fileNesting.patterns": {
        "*.svg": "${capture}.pdf, ${capture}.png, ${capture}.csv",
        "*stderr.log": "*.log",
        "README.md": "TODO.md, *.md",
        "pyproject.toml": "uv.lock, .python-version",
        "*.json": "${capture}.pkl",
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "Cargo.toml": "Cargo.lock"
    },
